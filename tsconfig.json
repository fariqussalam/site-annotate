{
  "compilerOptions": {
    "target": "ES2018",
    "module": "none",
    "lib": ["DOM", "ES2018"],
    "outFile": "dist/annotator.js",
    "removeComments": false,
    "sourceMap": false,
    "declaration": false,
    "strict": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
